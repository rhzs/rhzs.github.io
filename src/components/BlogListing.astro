---
import { getCollection } from 'astro:content';
import { categories } from '../data/profile';
interface Props { category?: 'life' | 'technical' | 'religious'; }
const { category } = Astro.props;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.date <= new Date() && (!category || data.category === category)))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const selected = categories.find((item) => item.id === category);
---
<nav class="category-tabs" aria-label="Blog categories"><a href="/writing/" aria-current={!category ? 'page' : undefined}>All writing</a>{categories.map((item) => <a href={`/writing/${item.id}/`} aria-current={item.id === category ? 'page' : undefined}>{item.name}</a>)}</nav>
{posts.length ? <div class="post-list">{posts.map((post) => <article><div class="post-meta"><span>{categories.find((item) => item.id === post.data.category)?.name}</span><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-GB', { dateStyle: 'medium', timeZone: 'UTC' })}</time></div><h2><a href={`/writing/posts/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="text-link" href={`/writing/posts/${post.id}/`}>Read article <span aria-hidden="true">↗</span></a></article>)}</div> : <div class="empty-state"><div class={`empty-glyph ${selected?.color ?? 'technical'}`} aria-hidden="true">{category === 'life' ? '◌' : category === 'religious' ? '✧' : '{ }'}</div><h2>No posts published yet</h2><p>{selected ? `This is where my ${selected.name.toLowerCase()} writing will live.` : 'A space for life stories, technical notes, and reflections on faith.'}<br />Check back for the first post.</p>{category && <a class="text-link" href="/writing/">Browse all categories</a>}</div>}
