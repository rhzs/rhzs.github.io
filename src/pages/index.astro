---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { categories, profile } from '../data/profile';
const posts = await getCollection('blog', ({ data }) => !data.draft && data.date <= new Date());
---
<Layout>
  <section class="hero">
    <div class="intro-line"><span class="status-dot" aria-hidden="true"></span>Principal Software Engineer at Grab</div>
    <h1>Rheza Satria.<br /><span class="hero-subtitle">An engineer,<br />with more to explore.</span></h1>
    <p class="hero-description">I build payment platforms and reliable software systems. This is my corner of the internet for professional work, everyday life, and reflections on faith.</p>
    <div class="hero-actions"><a class="button primary" href="/work/">Explore my work <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">A little about me</a></div>
  </section>

  <section class="home-work" aria-labelledby="work-heading">
    <div class="section-heading"><h2 id="work-heading">Built over the years</h2><a class="text-link" href="/work/">Full experience <span aria-hidden="true">↗</span></a></div>
    <p class="section-intro">More than 12 years across payments, healthcare, digital banking, and enterprise software.</p>
    <div class="featured-work">
      <a class="featured-item" href="/work/#grab"><span class="company-symbol grab" aria-hidden="true">G</span><div><span class="company-period">2021 — Present</span><h3>Grab</h3><p>Payment platforms at scale.<br />Principal Software Engineer.</p></div><span class="item-arrow" aria-hidden="true">↗</span></a>
      <a class="featured-item" href="/work/#prixaai"><span class="company-symbol prixa" aria-hidden="true">P</span><div><span class="company-period">2020 — 2021</span><h3>PRIXA.AI</h3><p>Connected healthcare products.<br />VP of Engineering.</p></div><span class="item-arrow" aria-hidden="true">↗</span></a>
      <a class="featured-item" href="/work/#bank-rakyat-indonesia"><span class="company-symbol bri" aria-hidden="true">B</span><div><span class="company-period">2018 — 2020</span><h3>Bank Rakyat Indonesia</h3><p>Digital lending and core banking.<br />Group Head.</p></div><span class="item-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="home-blog" aria-labelledby="blog-heading">
    <div class="section-heading"><h2 id="blog-heading">Beyond the day job</h2><a class="text-link" href="/writing/">Visit the blog <span aria-hidden="true">↗</span></a></div>
    <p class="section-intro">{posts.length ? 'Thoughts on life, technology, and faith.' : 'Three spaces for writing. The first posts are still to come.'}</p>
    <div class="category-grid">
      {categories.map((category) => {
        const count = posts.filter((post) => post.data.category === category.id).length;
        return <a class={`category-card ${category.color}`} href={`/writing/${category.id}/`}><span class="category-glyph" aria-hidden="true">{category.id === 'life' ? '◌' : category.id === 'technical' ? '{ }' : '✧'}</span><h3>{category.name}</h3><p>{category.description}</p><span class="category-foot">{count ? `${count} ${count === 1 ? 'post' : 'posts'}` : 'No posts yet'} <span aria-hidden="true">↗</span></span></a>;
      })}
    </div>
  </section>

  <aside class="contact-note"><p>Have something to share?<br /><span>I’d be happy to hear from you.</span></p><a class="text-link" href={`mailto:${profile.email}`}>Say hello <span aria-hidden="true">↗</span></a></aside>
</Layout>
